<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <android.widget.ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="12sp" android:textColor="#41474E" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_settings" android:layout_width="40dp" android:layout_height="match_parent"
                android:text="⋯" android:gravity="center" android:textSize="24sp" android:textColor="#0061A4" android:contentDescription="@string/widget_configure" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_navigation" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_previous" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center"
                android:text="‹" android:textSize="28sp" android:textColor="#0061A4" android:contentDescription="@string/previous_month" />
            <TextView android:id="@+id/widget_month" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:gravity="center" android:text="@string/nav_calendar" android:textSize="17sp" android:textStyle="bold" android:textColor="#0061A4" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_next" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center"
                android:text="›" android:textSize="28sp" android:textColor="#0061A4" android:contentDescription="@string/next_month" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_weekdays" android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" />
        <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:gravity="center" android:text="@string/widget_choose_profile" android:textSize="14sp" android:textColor="#1A1C1E" />
        <LinearLayout android:id="@+id/widget_weeks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
        <TextView android:id="@+id/widget_today" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center"
            android:text="@string/today_heading" android:textSize="13sp" android:textStyle="bold" android:textColor="#0061A4" />
    </LinearLayout>
</FrameLayout>
