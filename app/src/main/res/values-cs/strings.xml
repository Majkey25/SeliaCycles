    <string name="phase_guidance_title">Možné tělesné projevy</string>
    <string name="phase_feelings_title">Nálada a energie</string>
    <string name="phase_feelings_menstrual">Můžeš mít méně energie, potřebovat více klidu nebo být citlivější a zaměřená do sebe. Některé ženy žádnou emoční změnu nepozorují.</string>
    <string name="phase_feelings_follicular">Energie, motivace, soustředění nebo sebevědomí mohou postupně růst. Můžeš mít větší chuť být mezi lidmi nebo se pustit do náročnějších úkolů.</string>
    <string name="phase_feelings_fertile">Některé ženy mohou mít více energie, cítit se sebevědoměji nebo mít větší chuť na kontakt s lidmi a blízkost. Tyto pocity nepotvrzují ovulaci.</string>
    <string name="phase_feelings_ovulation">Některé ženy mají více energie, sebevědomí, empatie nebo sexuální touhy. Mnoho žen žádnou změnu nepozoruje.</string>
    <string name="phase_feelings_luteal">Energie může postupně klesat. Můžeš být citlivější, podrážděná, úzkostná, kreativní nebo potřebovat více klidu. Průběh se liší.</string>
    <string name="phase_guidance_menstrual">Během menstruace se mohou objevit křeče, bolest v bedrech, bolest hlavy, nadýmání nebo únava. Průběh je u každé ženy jiný.</string>
    <string name="phase_guidance_follicular">Tato odhadovaná fáze je po menstruaci a před odhadovaným plodným obdobím. Některé ženy mají více energie, jiné žádnou změnu nepozorují.</string>
    <string name="phase_guidance_fertile">Jde o odhad plodného období podle zapsaných cyklů. Nejde o potvrzení ovulace ani antikoncepci.</string>
    <string name="phase_guidance_ovulation">Jde o odhad dne ovulace. Některé ženy cítí krátkou jednostrannou bolest, mnoho žen necítí nic.</string>
    <string name="phase_guidance_luteal">Před menstruací se mohou objevit nadýmání, citlivost prsou, bolest hlavy, únava, chutě nebo změny nálady. Příznaky se mohou každý měsíc lišit.</string>
    <string name="phase_guidance_seek_help">Vyhledej lékařskou pomoc, pokud je bolest silná, horší než obvykle, vrací se nebo omezuje běžné činnosti.</string>
    <string name="phase_read_more">Číst více</string>
    <string name="phase_read_less">Skrýt podrobnosti</string>
    <string name="phase_social_title">Emoce a vztahy</string>
    <string name="phase_care_title">Jídlo, pohyb a odpočinek</string>
    <string name="phase_personal_pattern_title">Poznej svůj vzorec</string>
    <string name="phase_personal_pattern_body">Obecný popis fáze je jen začátek. Opakované záznamy nálady, energie, spánku, bolesti a stresu jsou užitečnější než stereotyp.</string>
    <string name="phase_education_disclaimer">Fáze jsou odhady. Nepředpovídají osobnost, nepotvrzují ovulaci, neurčují diagnózu PMS a nenahrazují lékařskou péči.</string>
    <string name="phase_social_menstrual">Můžeš být citlivější, mít méně trpělivosti nebo chtít více soukromí. Řekni blízkým, zda potřebuješ klid, praktickou pomoc nebo společnost. Pokud se chceš socializovat, zvol klidnější plán. Potřeba být sama je také normální.</string>
    <string name="phase_social_follicular">Energie a chuť být mezi lidmi mohou růst. Plánování, rozhovor nebo nová činnost mohou působit snáz. Nemusíš se tak cítit. Důležitější jsou tvoje vlastní záznamy energie a nálady.</string>
    <string name="phase_social_fertile">Některé ženy vnímají více sebevědomí, blízkosti nebo sexuálního zájmu, jiné nic. Odhad ovulace tyto pocity nepotvrzuje. Své hranice a potřeby sděluj přímo.</string>
    <string name="phase_social_ovulation">Některé ženy se cítí společenskyji, sebevědoměji nebo mají větší chuť na blízkost, mnoho žen nepozoruje změnu. Tyto pocity nepotvrzují ovulaci. Jasná komunikace a souhlas jsou stále důležité.</string>
    <string name="phase_social_luteal">Můžeš být podrážděnější, úzkostnější, citlivější na kritiku nebo potřebovat klid. Řekni si o prostor či jemnější komunikaci. Důležitý vztah neposuzuj podle jednoho těžšího dne.</string>
    <string name="phase_care_menstrual">Příjemné teplo, teplá koupel, jemný pohyb, spánek a doplnění tekutin mohou zvýšit pohodlí. Jez pravidelně a vyváženě. Při silném krvácení nebo obavách o železo se před doplňky poraď s lékařem.</string>
    <string name="phase_care_follicular">Pro tuto fázi není prokázaná zvláštní dieta. Jez běžná vyvážená jídla, pij podle žízně a pohyb zvyšuj postupně jen tehdy, když máš skutečně více energie.</string>
    <string name="phase_care_fertile">Žádné jídlo, cvičení ani pobyt na slunci nepotvrdí nebo neovládne ovulaci. Zvol vyvážené jídlo, tekutiny a pohyb, který je ti příjemný. Tento odhad není antikoncepce.</string>
    <string name="phase_care_ovulation">Kolem odhadované ovulace není potřeba zvláštní dieta ani aktivita. Jez běžně, doplňuj tekutiny a zvol příjemný pohyb. Odhad nepotvrzuje ovulaci ani nebrání těhotenství.</string>
    <string name="phase_care_luteal">Pravidelný aerobní pohyb, stálý spánek, celozrnné potraviny, fazole, čočka a zdroje vápníku mohou některé projevy PMS zmírnit. Sůl, přidaný cukr, kofein nebo alkohol omez, pokud podle tvých záznamů potíže zhoršují.</string>
    <string name="self_care_title">Péče pro úlevu</string>
    <string name="self_care_intro">Volitelné nápady pro větší pohodlí. Nejde o léčbu.</string>
    <string name="self_care_for_phase">Péče pro tuto fázi</string>
    <string name="self_care_activities">Doporučené aktivity</string>
    <string name="self_care_breathing">Pomalé dýchání</string>
    <string name="self_care_breathing_steps">Pohodlně se posaď. Pomalu se nadechni nosem a o něco déle vydechuj. Ramena nech uvolněná.</string>
    <string name="self_care_movement">Jemný pohyb</string>
    <string name="self_care_movement_steps">Pomalu rozhýbej ramena, boky a bedra jen v příjemném rozsahu. Protažení nikdy netlač přes bolest.</string>
    <string name="self_care_walk">Lehká chůze</string>
    <string name="self_care_walk_steps">Jdi klidným tempem, normálně dýchej a vyber si rovnou bezpečnou trasu.</string>
    <string name="self_care_heat">Příjemné teplo</string>
    <string name="self_care_heat_steps">Přilož na podbřišek teplý, ne horký nahřívací polštářek nebo termofor zabalený v látce. Kontroluj pokožku a při nepohodlí ho sundej. Neusínej s ním.</string>
    <string name="self_care_massage">Jemná masáž břicha nebo zad</string>
    <string name="self_care_massage_steps">Lehkým tlakem a pomalými pohyby masíruj podbřišek nebo bedra. Přestaň, pokud bolest zesílí nebo je místo citlivé.</string>
    <string name="self_care_minutes">%1$d min</string>
    <string name="self_care_hydration">Pomalé doplnění tekutin</string>
    <string name="self_care_hydration_steps">Pomalu vypij sklenici vody. Pokud ti lékař doporučil omezení tekutin, řiď se jeho pokyny.</string>
    <string name="self_care_rest">Klidný odpočinek</string>
    <string name="self_care_rest_steps">Pohodlně se posaď nebo si lehni s podepřenými bedry. Na deset minut uvolni čelist a ramena.</string>
    <string name="self_care_foot_massage">Jemná masáž chodidel</string>
    <string name="self_care_foot_massage_steps">Pohodlně se posaď. Palci lehce krouživě masíruj plosku a patu. Přestaň, pokud to bolí nebo je chodidlo necitlivé či oteklé.</string>
    <string name="self_care_back_stretch">Protažení beder</string>
    <string name="self_care_back_stretch_steps">Pohodlně se posaď nebo postav. Narovnej záda a bez tlačení se lehce předkloň. Přestaň, pokud se bolest zhorší.</string>
    <string name="self_care_knees_to_chest">Kolena k hrudníku</string>
    <string name="self_care_knees_to_chest_steps">Lehni si na záda a přitáhni jedno nebo obě kolena k hrudníku. Jemně je přidržuj a klidně dýchej. Přestaň, pokud je poloha nepříjemná.</string>
    <string name="self_care_pelvic_rocking">Jemné podsazování pánve</string>
    <string name="self_care_pelvic_rocking_steps">Lehni si s pokrčenými koleny nebo se opři o zeď. Pomalu nakláněj pánev dopředu a dozadu jen v příjemném rozsahu.</string>
    <string name="self_care_muscle_relaxation">Uvolnění svalů</string>
    <string name="self_care_muscle_relaxation_steps">Začni u ramen. Na tři sekundy lehce napni jednu svalovou skupinu a potom ji uvolni. Pokračuj směrem dolů a nezadržuj dech.</string>
