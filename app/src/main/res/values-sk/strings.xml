    <string name="phase_guidance_title">Možné telesné prejavy</string>
    <string name="phase_feelings_title">Nálada a energia</string>
    <string name="phase_feelings_menstrual">Môžeš mať menej energie, potrebovať viac pokoja alebo byť citlivejšia a zameraná do seba. Niektoré ženy necítia žiadnu emočnú zmenu.</string>
    <string name="phase_feelings_follicular">Energia, motivácia, sústredenie alebo sebadôvera môžu postupne rásť. Môžeš byť spoločenskejšia alebo mať chuť na náročnejšie úlohy.</string>
    <string name="phase_feelings_fertile">Niektoré ženy sa cítia energickejšie, sebavedomejšie, spoločenské alebo majú väčšiu chuť na blízkosť. Tieto pocity nepotvrdzujú ovuláciu.</string>
    <string name="phase_feelings_ovulation">Niektoré ženy majú viac energie, sebadôvery, empatie alebo sexuálnej túžby. Mnohé ženy necítia žiadnu zmenu.</string>
    <string name="phase_feelings_luteal">Energia môže postupne klesať. Môžeš byť citlivejšia, podráždená, úzkostná, kreatívna alebo potrebovať viac pokoja. Priebeh sa líši.</string>
    <string name="phase_guidance_menstrual">Počas menštruácie sa môžu objaviť kŕče, bolesť krížov, bolesť hlavy, nafukovanie alebo únava. Priebeh je u každej ženy iný.</string>
    <string name="phase_guidance_follicular">Táto odhadovaná fáza je po menštruácii a pred odhadovaným plodným obdobím. Niektoré ženy majú viac energie, iné necítia žiadnu zmenu.</string>
    <string name="phase_guidance_fertile">Ide o odhad plodného obdobia podľa zapísaných cyklov. Nepotvrdzuje ovuláciu a nie je antikoncepciou.</string>
    <string name="phase_guidance_ovulation">Ide o odhad dňa ovulácie. Niektoré ženy cítia krátku jednostrannú bolesť, mnohé necítia nič.</string>
    <string name="phase_guidance_luteal">Pred menštruáciou sa môžu objaviť nafukovanie, citlivosť pŕs, bolesť hlavy, únava, chute alebo zmeny nálady. Príznaky sa môžu každý mesiac líšiť.</string>
    <string name="phase_guidance_seek_help">Vyhľadaj lekársku pomoc, ak je bolesť silná, horšia než zvyčajne, vracia sa alebo obmedzuje bežné činnosti.</string>
    <string name="self_care_title">Starostlivosť pre úľavu</string>
    <string name="self_care_intro">Voliteľné nápady pre väčšie pohodlie. Nejde o liečbu.</string>
    <string name="self_care_breathing">Pomalé dýchanie</string>
    <string name="self_care_breathing_steps">Pohodlne sa posaď. Pomaly sa nadýchni nosom a o niečo dlhšie vydychuj. Ramená nechaj uvoľnené.</string>
    <string name="self_care_movement">Jemný pohyb</string>
    <string name="self_care_movement_steps">Pomaly rozhýb ramená, boky a kríže len v príjemnom rozsahu. Naťahovanie netlač cez bolesť.</string>
    <string name="self_care_walk">Ľahká chôdza</string>
    <string name="self_care_walk_steps">Kráčaj pokojným tempom, normálne dýchaj a vyber si rovnú bezpečnú trasu.</string>
    <string name="self_care_heat">Príjemné teplo</string>
    <string name="self_care_heat_steps">Prilož na podbruško teplý, nie horúci vankúšik alebo termofor zabalený v látke. Kontroluj pokožku a pri nepohodlí ho odlož. Nezaspávaj s ním.</string>
    <string name="self_care_massage">Jemná masáž brucha alebo chrbta</string>
    <string name="self_care_massage_steps">Ľahkým tlakom a pomalými pohybmi masíruj podbruško alebo kríže. Prestaň, ak sa bolesť zhorší alebo je miesto citlivé.</string>
    <string name="self_care_minutes">%1$d min</string>
    <string name="self_care_hydration">Pomalé doplnenie tekutín</string>
    <string name="self_care_hydration_steps">Pomaly vypi pohár vody. Ak ti lekár odporučil obmedzenie tekutín, riaď sa jeho pokynmi.</string>
    <string name="self_care_rest">Pokojný odpočinok</string>
    <string name="self_care_rest_steps">Pohodlne sa posaď alebo si ľahni s podopretými krížami. Na desať minút uvoľni čeľusť a ramená.</string>
    <string name="self_care_foot_massage">Jemná masáž chodidiel</string>
    <string name="self_care_foot_massage_steps">Pohodlne sa posaď. Palcami ľahko krúživo masíruj chodidlo a pätu. Prestaň, ak to bolí alebo je chodidlo necitlivé či opuchnuté.</string>
    <string name="self_care_back_stretch">Natiahnutie krížov</string>
    <string name="self_care_back_stretch_steps">Pohodlne sa posaď alebo postav. Vystri chrbát a bez tlačenia sa mierne predkloň. Prestaň, ak sa bolesť zhorší.</string>
    <string name="self_care_knees_to_chest">Kolená k hrudníku</string>
    <string name="self_care_knees_to_chest_steps">Ľahni si na chrbát a pritiahni jedno alebo obe kolená k hrudníku. Jemne ich pridržuj a pokojne dýchaj. Prestaň, ak je poloha nepríjemná.</string>
