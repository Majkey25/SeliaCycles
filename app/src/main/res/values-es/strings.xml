    <string name="cloud_unavailable">La sincronización de Google no está configurada</string>
    <string name="cloud_unavailable_body">Esta versión no tiene un proyecto Firebase ni un cliente Google OAuth verificados. El calendario local, las copias y las importaciones siguen funcionando.</string>
    <string name="google_account">Cuenta de Google</string>
    <string name="google_account_body">El inicio de sesión es opcional y solo se necesita para sincronizar y compartir con la pareja.</string>
    <string name="sign_in_google">Iniciar sesión con Google</string>
    <string name="cloud_sync">Sincronización en la nube</string>
    <string name="cloud_sync_disclosure">Al activarla, Google Firebase recibe el identificador de tu cuenta más las fechas del periodo y el flujo. Los datos diarios privados se excluyen. Desactivarla detiene las actualizaciones, pero no borra la copia en la nube.</string>
