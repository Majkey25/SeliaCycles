    <string name="calendar_selected">Wybrano</string>
    <string name="partner_view">Widok partnera</string>
    <string name="partner_view_body">Utwórz osobny kalendarz w Google Calendar lub Outlooku, udostępnij go partnerowi tylko do odczytu, a potem wybierz go tutaj. Selia kopiuje etykiety, ale nie może zmieniać uprawnień dostawcy.</string>
    <string name="forecast_saved">Zapisana prognoza: %1$s – %2$s</string>
    <string name="forecast_reconstructed">Odtworzona prognoza: %1$s – %2$s</string>
