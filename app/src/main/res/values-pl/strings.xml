    <string name="month_overview">Przegląd miesiąca</string>
    <string name="upcoming_cycle">Nadchodzące</string>
    <string name="more_about_cycle">Więcej o tym cyklu</string>
    <string name="phase_guidance_title">Możliwe objawy fizyczne</string>
    <string name="phase_feelings_title">Nastrój i energia</string>
    <string name="phase_feelings_menstrual">Możesz mieć mniej energii, potrzebować więcej odpoczynku albo czuć się bardziej wrażliwa i wycofana. Niektóre osoby nie zauważają zmian emocjonalnych.</string>
    <string name="phase_feelings_follicular">Energia, motywacja, skupienie lub pewność siebie mogą stopniowo rosnąć. Możesz mieć większą ochotę na kontakty i trudniejsze zadania.</string>
    <string name="phase_feelings_fertile">Niektóre osoby czują więcej energii, pewności siebie, towarzyskości lub potrzeby bliskości. Te odczucia nie potwierdzają owulacji.</string>
    <string name="phase_feelings_ovulation">Energia, pewność siebie, towarzyskość lub zainteresowanie seksem mogą być większe. Wiele osób nie zauważa zmian.</string>
    <string name="phase_feelings_luteal">Energia może stopniowo spadać. Możesz czuć większą wrażliwość, drażliwość, niepokój, kreatywność lub potrzebę spokoju. Odczucia są różne.</string>
    <string name="phase_guidance_menstrual">Podczas miesiączki mogą pojawić się skurcze, ból dolnej części pleców, ból głowy, wzdęcia lub zmęczenie. Objawy są różne u każdej osoby.</string>
    <string name="phase_guidance_follicular">Ta szacowana faza przypada po miesiączce i przed szacowanym okresem płodnym. Niektóre osoby mają więcej energii, inne nie zauważają zmiany.</string>
    <string name="phase_guidance_fertile">To szacowany okres płodny na podstawie zapisanych cykli. Nie potwierdza owulacji i nie jest antykoncepcją.</string>
    <string name="phase_guidance_ovulation">To szacowany dzień owulacji. Niektóre osoby czują krótki jednostronny ból, wiele nie odczuwa niczego.</string>
    <string name="phase_guidance_luteal">Przed miesiączką mogą pojawić się wzdęcia, tkliwość piersi, ból głowy, zmęczenie, zachcianki lub zmiany nastroju. Objawy mogą zmieniać się co miesiąc.</string>
    <string name="phase_guidance_seek_help">Skonsultuj się z lekarzem, jeśli ból jest silny, gorszy niż zwykle, nawraca lub utrudnia codzienne czynności.</string>
    <string name="self_care_title">Chwila dla siebie</string>
    <string name="self_care_intro">Opcjonalne pomysły dla większego komfortu. Nie zastępują leczenia.</string>
    <string name="self_care_breathing">Powolny oddech</string>
    <string name="self_care_breathing_steps">Usiądź wygodnie. Powoli wdychaj powietrze nosem i wydychaj trochę dłużej. Rozluźnij ramiona.</string>
    <string name="self_care_movement">Łagodny ruch</string>
    <string name="self_care_movement_steps">Powoli poruszaj ramionami, biodrami i dolną częścią pleców w wygodnym zakresie. Nie rozciągaj się na siłę.</string>
    <string name="self_care_walk">Spokojny spacer</string>
    <string name="self_care_walk_steps">Idź spokojnym tempem, oddychaj normalnie i wybierz płaską, bezpieczną trasę.</string>
    <string name="self_care_heat">Łagodne ciepło</string>
    <string name="self_care_heat_steps">Połóż na podbrzuszu ciepły, nie gorący termofor lub poduszkę owiniętą tkaniną. Często sprawdzaj skórę i zdejmij ją, jeśli czujesz dyskomfort. Nie zasypiaj z nią.</string>
    <string name="self_care_massage">Delikatny masaż brzucha lub pleców</string>
    <string name="self_care_massage_steps">Masuj podbrzusze lub dolną część pleców lekkim naciskiem i powolnymi ruchami. Przerwij, jeśli ból się nasila lub miejsce jest wrażliwe.</string>
    <string name="self_care_minutes">%1$d min</string>
    <string name="self_care_hydration">Powolne nawodnienie</string>
    <string name="self_care_hydration_steps">Powoli wypij szklankę wody. Jeśli lekarz zalecił ograniczenie płynów, stosuj się do tego zalecenia.</string>
    <string name="self_care_rest">Spokojny odpoczynek</string>
    <string name="self_care_rest_steps">Usiądź lub połóż się wygodnie z podparciem dolnej części pleców. Rozluźnij szczękę i ramiona na dziesięć minut.</string>
    <string name="self_care_foot_massage">Delikatny masaż stóp</string>
    <string name="self_care_foot_massage_steps">Usiądź wygodnie. Lekko masuj kciukami podeszwę i piętę okrężnymi ruchami. Przerwij przy bólu, drętwieniu lub obrzęku.</string>
    <string name="self_care_start">Zacznij</string>
    <string name="self_care_pause">Wstrzymaj</string>
    <string name="self_care_resume">Wznów</string>
    <string name="self_care_stop">Zakończ</string>
