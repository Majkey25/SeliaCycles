    <string name="phase_guidance_title">Possible physical signs</string>
    <string name="phase_feelings_title">Mood and energy</string>
    <string name="phase_feelings_menstrual">You may have lower energy, need more rest, or feel more sensitive or inward-focused. Some people notice no emotional change.</string>
    <string name="phase_feelings_follicular">Energy, motivation, focus, or confidence may gradually rise. Some people feel more social or ready for demanding tasks.</string>
    <string name="phase_feelings_fertile">Some people feel energetic, confident, social, or more interested in closeness. These feelings do not confirm ovulation.</string>
    <string name="phase_feelings_ovulation">Energy, confidence, sociability, or sexual interest may feel higher for some people. Many notice no change.</string>
    <string name="phase_feelings_luteal">Energy may gradually fall. You may feel more sensitive, irritable, anxious, creative, or in need of quiet. Experiences vary.</string>
    <string name="phase_guidance_menstrual">Some people notice cramps, lower-back discomfort, headache, bloating, or tiredness during a period. Symptoms vary.</string>
    <string name="phase_guidance_follicular">This estimated phase is after your period and before the estimated fertile window. Energy may feel higher for some people, but experiences vary.</string>
    <string name="phase_guidance_fertile">This is an estimated fertile window based on your logged cycles. It cannot confirm ovulation or be used as contraception.</string>
    <string name="phase_guidance_ovulation">This is an estimated ovulation day. Some people notice brief one-sided discomfort; many notice nothing.</string>
    <string name="phase_guidance_luteal">Some people notice bloating, breast tenderness, headache, tiredness, cravings, or mood changes before a period. Symptoms can change each month.</string>
    <string name="phase_guidance_seek_help">Seek medical advice if pain is severe, worse than usual, keeps returning, or disrupts normal activities.</string>
    <string name="self_care_title">Self-care</string>
    <string name="self_care_intro">Optional ideas that may help you feel more comfortable. They are not treatment.</string>
    <string name="self_care_breathing">Slow breathing</string>
    <string name="self_care_breathing_steps">Sit comfortably. Breathe in slowly through your nose, then breathe out a little longer. Keep your shoulders relaxed.</string>
    <string name="self_care_movement">Gentle movement</string>
    <string name="self_care_movement_steps">Move your shoulders, hips, and lower back slowly within a comfortable range. Avoid forcing a stretch.</string>
    <string name="self_care_walk">Gentle walk</string>
    <string name="self_care_walk_steps">Walk at an easy pace. Breathe normally and choose a flat, safe route.</string>
    <string name="self_care_heat">Gentle warmth</string>
    <string name="self_care_heat_steps">Place a warm, not hot, heat pad or wrapped hot-water bottle on your lower abdomen. Check your skin often and remove it if it feels uncomfortable. Do not sleep with it.</string>
    <string name="self_care_massage">Gentle tummy or back massage</string>
    <string name="self_care_massage_steps">Use light pressure and slow movements on your lower abdomen or lower back. Stop if pain increases or the area feels tender.</string>
    <string name="self_care_minutes">%1$d min</string>
    <string name="self_care_hydration">Slow hydration</string>
    <string name="self_care_hydration_steps">Drink a glass of water slowly. If a clinician has given you a fluid limit, follow that advice.</string>
    <string name="self_care_rest">Quiet rest</string>
    <string name="self_care_rest_steps">Sit or lie in a comfortable position with your lower back supported. Relax your jaw and shoulders for ten minutes.</string>
    <string name="self_care_foot_massage">Gentle foot massage</string>
    <string name="self_care_foot_massage_steps">Sit comfortably. Use your thumbs to massage the sole and heel with light circular pressure. Stop if it hurts or the foot is numb or swollen.</string>
    <string name="self_care_start">Start</string>
    <string name="self_care_pause">Pause</string>
    <string name="self_care_resume">Resume</string>
    <string name="self_care_stop">Stop</string>
    <string name="self_care_safety">Move only within a comfortable range. Stop if pain increases, you feel dizzy, or feel unwell.</string>
